{
    "name": "tajiafrica/mpesa",
    "description": "M-Pesa SDK for Laravel — comprehensive, config-driven, with rich exception handling",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "TajiAfrica",
            "email": "dev@tajiafrica.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "illuminate/contracts": "^13.0",
        "guzzlehttp/guzzle": "^7.14"
    },
    "require-dev": {
        "laravel/boost": "^2.4",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "TajiAfrica\\Mpesa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TajiAfrica\\Mpesa\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TajiAfrica\\Mpesa\\MpesaServiceProvider"
            ],
            "aliases": {
                "Mpesa": "TajiAfrica\\Mpesa\\Facades\\Mpesa"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
